# Copy to .env and provide your own PostgreSQL credentials.
TRACEAI_DB_BACKEND=postgresql
POSTGRES_DB=traceai
POSTGRES_USER=traceai
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Optional: never needed for deterministic analysis.
OPENAI_API_KEY=
TRACEAI_AI_MODEL=gpt-5
